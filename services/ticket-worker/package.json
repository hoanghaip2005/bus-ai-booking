{
  "name": "@bus/ticket-worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@bus/contracts-events": "workspace:*",
    "@bus/contracts-proto": "workspace:*",
    "@bus/observability": "workspace:*",
    "@bus/worker-runtime": "workspace:*",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/microservices": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "amqplib": "2.0.1",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pdfkit": "0.17.5",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
