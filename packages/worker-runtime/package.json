{
  "name": "@bus/worker-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@bus/contracts-events": "workspace:*",
    "@bus/observability": "workspace:*",
    "amqplib": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "5.9.3"
  }
}
