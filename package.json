{
  "name": "intercity-bus-booking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo dev --concurrency=16",
    "build": "turbo build",
    "clean": "turbo clean && node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:contract": "pnpm contracts:check",
    "test:e2e": "playwright test",
    "test:seat-race": "vitest run --config vitest.integration.config.ts --passWithNoTests -t seat-race",
    "test:workers": "vitest run --config vitest.integration.config.ts --passWithNoTests -t workers",
    "test:mcp": "vitest run --config vitest.integration.config.ts --passWithNoTests -t mcp",
    "test:ai-eval": "vitest run --config vitest.e2e.config.ts --passWithNoTests -t ai-eval",
    "test:smoke": "node scripts/smoke-foundation.mjs",
    "test:backup-restore": "node scripts/backup-restore-drill.mjs",
    "test:mcp-load": "node scripts/mcp-load.mjs",
    "test:release-dashboard": "node scripts/validate-release-dashboard.mjs",
    "demo:verify": "node scripts/wait-for-apps.mjs && pnpm test:smoke && pnpm test:mcp-load",
    "contracts:generate": "pnpm --filter @bus/contracts-proto generate && pnpm --filter @bus/contracts-graphql generate",
    "contracts:lint": "pnpm --filter @bus/contracts-proto lint && pnpm --filter @bus/contracts-graphql lint && pnpm --filter @bus/contracts-events lint",
    "contracts:check": "pnpm contracts:lint && pnpm contracts:generate && node scripts/check-generated.mjs",
    "verify": "pnpm check && pnpm test:contract && pnpm test:unit && pnpm build",
    "env:up": "docker compose -f infra/docker-compose.yml up -d",
    "env:wait": "node scripts/wait-for-infra.mjs",
    "env:down": "docker compose -f infra/docker-compose.yml down --remove-orphans",
    "env:clean": "docker compose -f infra/docker-compose.yml down -v --remove-orphans",
    "db:migrate": "node scripts/run-db.mjs migrate",
    "db:seed": "node scripts/run-db.mjs seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "amqplib": "2.0.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "graphql-ws": "6.1.0",
    "kafkajs": "2.2.4",
    "prettier": "3.9.5",
    "redis": "5.8.2",
    "tsx": "4.23.0",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10",
    "ws": "8.21.0"
  }
}
